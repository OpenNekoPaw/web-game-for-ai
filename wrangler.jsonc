{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agent-game-arena",
  "main": "worker.js",
  "compatibility_date": "2026-08-20",
  "assets": {
    "directory": "./public",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/agent/*", "/mcp"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "GAME_STATE", "class_name": "ArenaDurableObject" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ArenaDurableObject"] }
  ],
  "r2_buckets": [
    { "binding": "REPLAYS", "bucket_name": "agent-game-ddz-replays" }
  ]
}
